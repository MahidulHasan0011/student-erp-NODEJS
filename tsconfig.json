{
  // ─────────────────────────────────────────────────────────────────────────
  // Base config — editor (IntelliSense), `npm run typecheck`, and vitest use this.
  // It never emits; the actual build uses tsconfig.build.json (which extends this).
  //
  // The JS → TS migration is complete: every file under src/, tests/ and database/
  // is TypeScript, allowJs is off, and strict is on. A stray .js file added under
  // those folders is now a build error rather than an untyped hole.
  // ─────────────────────────────────────────────────────────────────────────
  "compilerOptions": {
    // ── Output target ──
    // Node 24 runtime. ES2022 keeps top-level await (used in src/server.ts) native.
    "target": "ES2022",
    "lib": ["ES2023"],

    // ── Module system ──
    // NodeNext is required because package.json has "type": "module".
    // It also means imports keep their `.js` extension inside .ts files —
    // which this codebase already does everywhere, so no import paths change.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // Type-only imports must be written `import type { X }` and are erased from
    // the output. Prevents a type-only import surviving into emitted JS and
    // crashing at runtime on a missing export.
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    // ── No JavaScript ──
    // Nothing under src/, tests/ or database/ is .js any more, so this stays false;
    // it is what keeps the codebase from drifting back.
    "allowJs": false,

    // ── Strictness ──
    // strict turns on: noImplicitAny, strictNullChecks, strictFunctionTypes,
    // strictBindCallApply, strictPropertyInitialization, noImplicitThis,
    // alwaysStrict and useUnknownInCatchVariables.
    //
    // Deliberately NOT enabled, having been measured against this codebase:
    //   noUncheckedIndexedAccess (123 errors) — nearly all are `rows[0]` right after
    //     an INSERT … RETURNING, or `statements[i]` inside a bounded for-loop. Provably
    //     safe, unprovable to the compiler; it would buy ~123 `!` assertions and no bugs.
    //   exactOptionalPropertyTypes (48) — the assert* validators return `T | undefined`
    //     for optional fields, which is exactly the intent, and this flag rejects passing
    //     that to `field?: T`. It also fails against node-redis's own RedisClientOptions,
    //     which is not ours to fix.
    //   noPropertyAccessFromIndexSignature (126) — purely stylistic (obj['k'] vs obj.k).
    // Re-measure before turning any of them on; the counts are from a clean tree.
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    // ── swagger-jsdoc reads the @openapi JSDoc blocks out of the route files,
    //    so comments must survive compilation. Do not set this to true. ──
    "removeComments": false,

    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "noEmit": true,

    "types": ["node"]
  },
  "include": ["src/**/*", "database/**/*", "tests/**/*", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "coverage", "business-plan"]
}
